{
  "name": "aplime",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:web && npm run build:admin",
    "start": "npm run start:web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/database.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "worker": "tsx src/server/worker.ts",
    "config:check": "tsx scripts/check-config.ts",
    "identity:check": "tsx scripts/check-identity.ts",
    "maps:check": "tsx scripts/check-maps.ts",
    "mobile:prepare": "tsx scripts/prepare-mobile.ts",
    "mobile:sync": "npm run build:web && npm run mobile:prepare && npx cap sync",
    "mobile:ios": "cap open ios",
    "mobile:android": "cap open android",
    "dev:web": "tsx watch apps/web/server.ts",
    "dev:api": "tsx watch apps/api/server.ts",
    "dev:admin": "vite --config apps/admin/vite.config.ts",
    "build:web": "npm run typecheck && vite build && vite build --ssr src/entry-server.tsx --outDir dist/server",
    "build:admin": "vite build --config apps/admin/vite.config.ts && node scripts/admin-build-stamp.mjs",
    "start:web": "tsx apps/web/server.ts",
    "start:api": "tsx apps/api/server.ts",
    "admin:access": "tsx scripts/admin-access.ts",
    "admin:setup": "tsx scripts/admin-setup.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@capacitor-firebase/authentication": "^7.5.0",
    "@capacitor/android": "^7.4.3",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "@sentry/node": "^10.0.0",
    "@sentry/react": "^10.0.0",
    "@upstash/ratelimit": "^2.0.0",
    "@upstash/redis": "^1.35.0",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "firebase": "^11.2.0",
    "firebase-admin": "^14.4.0",
    "helmet": "^8.1.0",
    "lucide-react": "^1.31.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.16.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "stripe": "^18.0.0",
    "tsx": "^4.23.15",
    "zod": "^3.25.76"
  },
  "overrides": {
    "gaxios": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@electric-sql/pglite": "^0.5.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "22.19.19",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "prettier": "^3.0.0",
    "typescript": "5.9.3",
    "vite": "^8.3.0",
    "yaml": "^2.8.0"
  }
}
