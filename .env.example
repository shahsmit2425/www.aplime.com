# Local development. Copy to .env; never commit credential values.
# On Render use common and backend environment groups per environment; see docs/ENVIRONMENT_VARIABLES.md.
NODE_ENV=development
APP_ENV=development
API_URL=http://127.0.0.1:3001
ADMIN_ALLOWED_UIDS=
PORT=3001
SITE_URL=http://127.0.0.1:5173
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,capacitor://localhost,https://localhost
DATABASE_URL=
# disable only for local Postgres; Render Blueprint uses render-internal
DATABASE_SSL=disable
DATABASE_CA_CERT=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Dedicated destinations; keep the combined secret above only during migration.
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=
STRIPE_IDENTITY_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
# Set all three for the new membership selector. The value above is legacy fallback.
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_SIX_MONTH_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
DAILY_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
GOOGLE_MAPS_SERVER_KEY=
# Temporary broad browsing; switch to matched to restore category/radius discovery.
MARKETPLACE_DISCOVERY_MODE=matched
# Development-only listing preview; false restores normal eligibility/size limits.
MARKETPLACE_PREVIEW=true
# Backend only. Verify EMAIL_FROM's domain in Resend before sending.
RESEND_API_KEY=
EMAIL_FROM=notification@aplime.com
# Optional real inbox for replies; keep Microsoft 365 receiving mail if used.
EMAIL_REPLY_TO=support@aplime.com
SENTRY_DSN=
PUBLIC_SENTRY_DSN=
SUPPORT_EMAIL=
# RENDER_GIT_COMMIT is supplied automatically by Render, not a secret.
